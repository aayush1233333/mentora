# ─────────────────────────────────────────────
# Mentora Backend – Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# App
ENV=development                          # development | production
PORT=8000
CORS_ORIGINS=http://localhost:3000       # comma-separated for multiple





# OpenAI (for chatbot)
OPENAI_API_KEY=sk-...your-openai-key...

# Secret key (for future JWT signing if needed)
SECRET_KEY=change-me-in-production

# Model weights path (optional override)
MODEL_WEIGHTS_PATH=./ai_model/weights/cnn_lstm_v1.h5


